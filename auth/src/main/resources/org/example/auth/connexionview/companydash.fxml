<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import java.net.URL?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox fx:id="root" alignment="CENTER" prefHeight="481.0" prefWidth="598.0" spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.connexion.CompanyDashController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <ComboBox fx:id="languageComboBox" styleClass="language-combo-box">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="English"/>
                <String fx:value="Français"/>
            </FXCollections>
        </items>
    </ComboBox>

    <!-- Post an Offer Button -->
    <Button fx:id="postOfferButton" onAction="#handlePostOffer" text="Post an Offer" styleClass="dashboard-button" />

    <!-- View My Posts Button -->
    <Button fx:id="viewPostsButton" onAction="#handleViewPosts" text="View My Posts" styleClass="dashboard-button" />

    <!-- View Applicants Button -->
    <Button fx:id="viewApplicantsButton" onAction="#handleViewApplicants" text="View Applicants" styleClass="dashboard-button" />

    <!-- View Employees Button -->
    <Button fx:id="viewEmployeesButton" onAction="#handleViewEmployees" text="View Employees" styleClass="dashboard-button" />
</VBox>