<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.auth.controllers.JobAndApplicantion.ApplyJobController"
            prefHeight="300.0" prefWidth="400.0">

    <VBox spacing="10" layoutX="20" layoutY="20">
        <Label text="Comment:"/>
        <TextField fx:id="commentField"/>

        <Label text="Additional File (link or text):"/>
        <TextField fx:id="additionalFileField"/>

        <Button text="Submit" fx:id="submitButton" onAction="#handleSubmit"/>
    </VBox>

</AnchorPane>
