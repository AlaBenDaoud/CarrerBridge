<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.auth.controllers.JobAndApplicantion.ApplyJobController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">

    <!-- VBox for layout -->
    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
        <!-- Title -->
        <Label text="Apply for Job"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f8fafc; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.4), 15, 0, 0, 2);"/>

        <!-- Comment Field -->
        <Label text="Comment:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
        <TextField fx:id="commentField"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #f8fafc; -fx-background-color: rgba(30, 41, 59, 0.7); -fx-border-radius: 8px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-background-radius: 8px; -fx-padding: 8px;"/>

        <!-- Additional File Field -->
        <Label text="Additional File (link or text):" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
        <TextField fx:id="additionalFileField"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #f8fafc; -fx-background-color: rgba(30, 41, 59, 0.7); -fx-border-radius: 8px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-background-radius: 8px; -fx-padding: 8px;"/>

        <!-- Submit Button -->
        <Button text="Submit" fx:id="submitButton" onAction="#handleSubmit"
                style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
    </VBox>
</AnchorPane>