<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.JobAndApplicantion.EditJobController"
      spacing="20" alignment="CENTER" style="-fx-background-color: #ffffff;">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Title -->
    <Text text="Edit Job Details" style="-fx-fill: #2c3e50;">
        <font>
            <Font name="Roboto" size="28" />
        </font>
    </Text>

    <!-- Job ID (Read-only) -->
    <Label text="Job ID:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    <TextField fx:id="idField" promptText="Job ID" editable="false" prefWidth="300" />

    <!-- Job Title -->
    <Label text="Job Title:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    <TextField fx:id="titleField" promptText="Job Title" prefWidth="300" />

    <!-- Job Description -->
    <Label text="Job Description:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    <TextArea fx:id="descriptionField" promptText="Job Description" prefWidth="300" prefHeight="100" />

    <!-- Position -->
    <Label text="Position:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    <TextField fx:id="positionField" promptText="Position" prefWidth="300" />

    <!-- Location -->
    <Label text="Location:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    <TextField fx:id="locationField" promptText="Location" prefWidth="300" />

    <!-- Save Button -->
    <Button text="Save Changes" onAction="#handleSaveChanges" prefWidth="300" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" />

    <!-- Cancel Button -->
    <Button text="Cancel" onAction="#handleCancel" prefWidth="300" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" />
</VBox>
