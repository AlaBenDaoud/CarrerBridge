<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<?import javafx.scene.layout.HBox?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.auth.controllers.JobAndApplicantion.JobDetailController"
            prefHeight="500.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">

    <!-- VBox for layout -->
    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
        <!-- Job Title -->
        <Label fx:id="titleLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>

        <!-- Job Description -->
        <Label fx:id="descriptionLabel" wrapText="true" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #f8fafc;"/>

        <!-- Company -->
        <Label fx:id="companyLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #f8fafc;"/>

        <!-- Location -->
        <Label fx:id="locationLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #f8fafc;"/>

        <!-- Posted Date -->
        <Label fx:id="postedDateLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #f8fafc;"/>

        <!-- Action Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="Apply" fx:id="applyButton" onAction="#handleApply"
                    style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
            <Button text="Back to Main" fx:id="backButton" onAction="#handleBackButton"
                    style="-fx-text-fill: white; -fx-background-color: #e74c3c; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</AnchorPane>