<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.auth.controllers.JobAndApplicantion.JobDetailController"
            prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">

    <ScrollPane fitToWidth="true" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="25" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40" />
            </padding>

            <!-- Header with job title -->
            <Label fx:id="titleLabel" wrapText="true"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;">
                <effect>
                    <DropShadow color="#00000080" radius="4" />
                </effect>
            </Label>

            <!-- Company and location info -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox style="-fx-background-color: #2d3748; -fx-background-radius: 10px;"
                      maxWidth="Infinity" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="15" right="20" bottom="15" left="20" />
                    </padding>

                    <Label fx:id="companyLabel"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" />
                    <Label fx:id="locationLabel"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #a0aec0;" />
                    <Label fx:id="postedDateLabel"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #a0aec0;" />
                </VBox>
            </HBox>

            <!-- Job description -->
            <VBox style="-fx-background-color: #2d3748; -fx-background-radius: 10px;" spacing="15">
                <padding>
                    <Insets top="20" right="25" bottom="20" left="25" />
                </padding>

                <Label text="Job Description"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" />

                <Label fx:id="descriptionLabel" wrapText="true"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-text-fill: #e2e8f0; -fx-line-spacing: 1.5;" />
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="Apply Now" fx:id="applyButton" onAction="#handleApply"
                        style="-fx-text-fill: white; -fx-background-color: #4ade80; -fx-font-family: 'Segoe UI';
                               -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12px 30px;
                               -fx-background-radius: 30px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
                </Button>

                <Button text="Back to Jobs" fx:id="backButton" onAction="#handleBackButton"
                        style="-fx-text-fill: white; -fx-background-color: #64748b; -fx-font-family: 'Segoe UI';
                               -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12px 30px;
                               -fx-background-radius: 30px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
                </Button>
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>