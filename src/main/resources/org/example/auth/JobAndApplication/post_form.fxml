<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.auth.controllers.JobAndApplicantion.PostFormController"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b); -fx-padding: 30;">

    <!-- Title -->
    <Label text="Create a New Post"
           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f8fafc; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.4), 15, 0, 0, 2);"/>

    <!-- Post Content -->
    <TextArea fx:id="postContent"
              promptText="Write your post..."
              wrapText="true"
              prefHeight="150"
              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #000000; -fx-background-color: rgba(30, 41, 59, 0.7); -fx-border-radius: 8px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-background-radius: 8px; -fx-padding: 10;"/>

    <!-- Upload Buttons -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="📷 Upload Image"
                onAction="#handleUploadImage"
                style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
        <Button text="📄 Upload PDF"
                onAction="#handleUploadPdf"
                style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
    </HBox>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="✅ Submit Post"
                onAction="#handleSubmitPost"
                style="-fx-text-fill: white; -fx-background-color: #27ae60; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 30px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
        <Button text="❌ Cancel"
                onAction="#handleCancel"
                style="-fx-text-fill: white; -fx-background-color: #e74c3c; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 30px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
    </HBox>

</VBox>