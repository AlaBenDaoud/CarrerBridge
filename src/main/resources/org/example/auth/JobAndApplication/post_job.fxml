<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.JobAndApplicantion.PostJobController"
      spacing="20" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Title -->
    <Text text="Post a Job" style="-fx-fill: #f8fafc;">
        <font>
            <Font name="Segoe UI" size="32" />
        </font>
        <effect>
            <DropShadow color="#000000" radius="5" spread="0.2" offsetX="2" offsetY="2"/>
        </effect>
    </Text>

    <!-- Job Title -->
    <Label text="Job Title:" style="-fx-text-fill: #94a3b8; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="titleField" promptText="Enter job title" prefWidth="500" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px; -fx-text-fill: #f8fafc; -fx-control-inner-background: rgba(30, 41, 59, 0.7);" />

    <!-- Job Description -->
    <Label text="Job Description:" style="-fx-text-fill: #94a3b8; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextArea fx:id="descriptionField" promptText="Enter job description" prefWidth="500" prefHeight="200" wrapText="true" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px; -fx-text-fill: #f8fafc; -fx-control-inner-background: rgba(30, 41, 59, 0.7);" />

    <!-- Company ID -->
    <Label text="Company ID:" style="-fx-text-fill: #94a3b8; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="companyIdField" promptText="Enter company ID" prefWidth="500" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px; -fx-text-fill: #f8fafc; -fx-control-inner-background: rgba(30, 41, 59, 0.7);" />

    <!-- Position -->
    <Label text="Position:" style="-fx-text-fill: #94a3b8; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="positionField" promptText="Enter job position" prefWidth="500" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px; -fx-text-fill: #f8fafc; -fx-control-inner-background: rgba(30, 41, 59, 0.7);" />

    <!-- Location -->
    <Label text="Location:" style="-fx-text-fill: #94a3b8; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="locationField" promptText="Enter job location" prefWidth="500" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px; -fx-text-fill: #f8fafc; -fx-control-inner-background: rgba(30, 41, 59, 0.7);" />

    <!-- Buttons Container -->
    <VBox spacing="15" alignment="CENTER">
        <!-- Submit Button -->
        <Button text="Post Job" onAction="#handlePostJobButton" prefWidth="250" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#000000" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>

        <!-- Back Button -->
        <Button text="Back to Main" onAction="#handleBackButton" prefWidth="250" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#000000" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>
    </VBox>
</VBox>