<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.JobAndApplicantion.PostJobController"
      spacing="20" alignment="CENTER" style="-fx-background-color: #ffffff;" stylesheets="@style.css">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Title -->
    <Text text="Post a Job" style="-fx-fill: #34495e;">
        <font>
            <Font name="Roboto" size="32" />
        </font>
        <effect>
            <DropShadow color="#aaaaaa" radius="5" spread="0.2" offsetX="2" offsetY="2"/>
        </effect>
    </Text>

    <!-- Job Title -->
    <Label text="Job Title:" style="-fx-text-fill: #555555; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="titleField" promptText="Enter job title" prefWidth="500" style="-fx-font-size: 16; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-border-width: 1;" />

    <!-- Job Description -->
    <Label text="Job Description:" style="-fx-text-fill: #555555; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextArea fx:id="descriptionField" promptText="Enter job description" prefWidth="500" prefHeight="200" wrapText="true" style="-fx-font-size: 16; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-border-width: 1;" />

    <!-- Company ID -->
    <Label text="Company ID:" style="-fx-text-fill: #555555; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="companyIdField" promptText="Enter company ID" prefWidth="500" style="-fx-font-size: 16; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-border-width: 1;" />

    <!-- Position -->
    <Label text="Position:" style="-fx-text-fill: #555555; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="positionField" promptText="Enter job position" prefWidth="500" style="-fx-font-size: 16; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-border-width: 1;" />

    <!-- Location -->
    <Label text="Location:" style="-fx-text-fill: #555555; -fx-font-size: 16; -fx-font-weight: bold;" />
    <TextField fx:id="locationField" promptText="Enter job location" prefWidth="500" style="-fx-font-size: 16; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-border-width: 1;" />

    <!-- Buttons Container -->
    <VBox spacing="15" alignment="CENTER">
        <!-- Submit Button -->
        <Button text="Post Job" onAction="#handlePostJobButton" prefWidth="250" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="#27ae60" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>

        <!-- Back Button -->
        <Button text="Back to Main" onAction="#handleBackButton" prefWidth="250" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="#2980b9" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>
    </VBox>
</VBox>
