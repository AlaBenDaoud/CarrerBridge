<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.auth.controllers.JobAndApplicantion.PostController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="Actualiser" onAction="#refreshPosts"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="postContainer" spacing="10" style="-fx-padding: 10;">
                <!-- Les cartes des publications seront ajoutées ici dynamiquement -->
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

