<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.JobAndApplicantion.ViewApplicantByIdController"
      spacing="20" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Title -->
    <Text text="Your Applications" style="-fx-fill: #f8fafc;">
        <font>
            <Font name="Segoe UI" size="28" />
        </font>
    </Text>

    <!-- Back Button -->
    <Button text="Back to Dashboard" onAction="#handleBackButton"
            style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;"/>

    <!-- ScrollPane for Job Cards -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox fx:id="applicationsContainer" spacing="15" style="-fx-padding: 10;">
            <!-- Application cards will be added here dynamically -->
        </VBox>
    </ScrollPane>
</VBox>