<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.JobAndApplicantion.ViewApplicantByIdController"
      spacing="20" alignment="CENTER" style="-fx-background-color: #ffffff;">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Title -->
    <Text text="View Applications by Applicant ID" style="-fx-fill: #2c3e50;">
        <font>
            <Font name="Roboto" size="28" />
        </font>
    </Text>

    <!-- Applicant ID Input -->
    <TextField fx:id="applicantIdField" promptText="Enter Applicant ID" prefWidth="300" />

    <!-- Fetch Button -->
    <Button text="Fetch Applications" onAction="#handleFetchApplicant" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>

    <!-- Applications Table -->
    <TableView fx:id="applicationsTable" prefWidth="600" visible="false">
        <columns>
            <TableColumn fx:id="idColumn" text="Application ID" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="jobIdColumn" text="Job ID" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="jobId" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="companyIdColumn" text="Company ID" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="companyId" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="commentColumn" text="Comment" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="comment" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="additionalFileColumn" text="Additional File" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="additionalFile" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100">  <!-- Added status column -->
                <cellValueFactory>
                    <PropertyValueFactory property="status" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="appliedDateColumn" text="Applied Date" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="appliedDate" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <!-- Details Container (Make sure this is defined and visible) -->
    <VBox fx:id="detailsContainer" spacing="10" visible="false">
        <!-- Add content here (for example, applicant details or additional info) -->
        <Label text="Details" />
    </VBox>
</VBox>
