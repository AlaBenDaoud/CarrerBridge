<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.auth.controllers.JobAndApplicantion.ViewJobsController"
            prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: #f1f5f9;">

    <VBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-padding: 16 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">

            <Button text="← Back" fx:id="backButton" onAction="#handleBackButton"
                    style="-fx-text-fill: #6b7280;
                           -fx-background-color: transparent;
                           -fx-font-size: 14px;
                           -fx-cursor: hand;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Show Best Matches" fx:id="bestMatchButton" onAction="#handleBestMatchButton"
                    style="-fx-text-fill: white;
                           -fx-background-color: #4f46e5;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-padding: 8 16;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.3), 4, 0, 0, 1);">
                <graphic>
                    <Circle fill="white" radius="3"/>
                </graphic>
            </Button>
        </HBox>

        <!-- Main Content Area -->
        <VBox spacing="16" style="-fx-padding: 24;">
            <!-- Stats Section -->
            <HBox spacing="16">
                <VBox styleClass="stat-card"
                      style="-fx-background-color: white;
                             -fx-padding: 16;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">
                    <Label text="Available Jobs"
                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                    <Label fx:id="jobCountLabel" text="0"
                           style="-fx-text-fill: #0f172a; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox styleClass="stat-card"
                      style="-fx-background-color: white;
                             -fx-padding: 16;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">
                    <Label text="Matching Rate"
                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                    <Label fx:id="matchRateLabel" text="0%"
                           style="-fx-text-fill: #0f172a; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search jobs by title, position, or location..."
                           style="-fx-background-color: white;
                                 -fx-padding: 10 15;
                                 -fx-background-radius: 8;
                                 -fx-font-size: 14px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 2, 0, 0, 1);"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Jobs List Section -->
            <VBox spacing="12">
                <Label text="Available Positions"
                       style="-fx-text-fill: #0f172a; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: transparent;
                                  -fx-border-color: transparent;
                                  -fx-padding: 0;">
                    <VBox fx:id="jobsContainer" spacing="12">
                        <!-- Job cards will be added here dynamically -->
                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>
    </VBox>

    <stylesheets>
        /* Scrollbar Styling */
        .scroll-pane {
        -fx-background-color: transparent;
        -fx-border-color: transparent;
        }

        .scroll-pane > .viewport {
        -fx-background-color: transparent;
        }

        .scroll-bar:vertical {
        -fx-background-color: transparent;
        -fx-pref-width: 12;
        }

        .scroll-bar:vertical .thumb {
        -fx-background-color: #cbd5e1;
        -fx-background-radius: 6;
        }

        .scroll-bar:vertical .track {
        -fx-background-color: transparent;
        }

        /* Button Styles */
        .button {
        -fx-transition: all 0.2s ease;
        }

        #backButton:hover {
        -fx-text-fill: #0f172a;
        }

        #bestMatchButton:hover {
        -fx-background-color: #4338ca;
        }

        /* Card Styles */
        .stat-card {
        -fx-transition: all 0.2s ease;
        }

        .stat-card:hover {
        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);
        -fx-translate-y: -2;
        }

        /* Text Field Styles */
        .text-field {
        -fx-transition: all 0.2s ease;
        }

        .text-field:focused {
        -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.3), 4, 0, 0, 1);
        -fx-border-color: #4f46e5;
        -fx-border-width: 1px;
        -fx-border-radius: 8;
        }

