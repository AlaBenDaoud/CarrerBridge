<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.Congee.ApplyRemoteWorkController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Apply for Remote Work" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Title:"/>
    <TextField fx:id="titleField" promptText="Enter job title"/>

    <Label text="Description:"/>
    <TextField fx:id="postField" promptText="Enter job description" VBox.vgrow="ALWAYS"/>

    <Label text="Start Date:"/>
    <DatePicker fx:id="startDatePicker" promptText="Select start date"/>

    <Label text="End Date:"/>
    <DatePicker fx:id="endDatePicker" promptText="Select end date"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="submitButton" text="Submit" onAction="#handleSubmit" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20;"/>
    </HBox>
</VBox>