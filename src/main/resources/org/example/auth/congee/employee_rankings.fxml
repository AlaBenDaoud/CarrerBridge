<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.auth.controllers.Congee.EmployeeRankingsController"
      spacing="15" style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #c3cfe2);">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header Section -->
    <StackPane>
        <VBox alignment="CENTER" spacing="5">
            <Label text="Employee Attendance Leaderboard" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
                <effect>
                    <DropShadow color="#0000001a" radius="4" spread="0.05"/>
                </effect>
            </Label>
            <Label text="Recognizing exemplary attendance records" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;">
                <font>
                    <Font name="System Italic" size="16"/>
                </font>
            </Label>
        </VBox>
    </StackPane>

    <!-- Podium Section -->
    <AnchorPane fx:id="podiumContainer" minHeight="220" style="-fx-background-color: transparent;">
        <!-- Second Place Podium -->
        <StackPane AnchorPane.leftAnchor="180" AnchorPane.bottomAnchor="0">
            <Rectangle width="150" height="130" arcWidth="10" arcHeight="10">
                <fill>
                    <LinearGradient startX="0.0" startY="0.0" endX="0.0" endY="1.0">
                        <stops>
                            <Stop color="#C0C0C0"/>
                            <Stop color="#A0A0A0" offset="1.0"/>
                        </stops>
                    </LinearGradient>
                </fill>
                <effect>
                    <DropShadow color="#00000066" radius="5" spread="0.05"/>
                </effect>
            </Rectangle>
            <VBox alignment="CENTER" spacing="5">
                <Label text="2" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <effect>
                        <DropShadow/>
                    </effect>
                </Label>
                <StackPane>
                    <Circle radius="30" fx:id="secondPlaceCircle" fill="white" stroke="#A0A0A0" strokeWidth="2"/>
                    <Label fx:id="secondPlaceInitial" text="E2" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                </StackPane>
                <Label fx:id="secondPlaceId" text="ID: --" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="secondPlaceAchievement" text="--" style="-fx-background-color: rgba(25, 118, 210, 0.7); -fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 10;"/>
                <Label fx:id="secondPlaceLeaves" text="Leaves: 0" style="-fx-text-fill: white;"/>
            </VBox>
        </StackPane>

        <!-- First Place Podium -->
        <StackPane AnchorPane.leftAnchor="350" AnchorPane.bottomAnchor="0">
            <Rectangle width="170" height="180" arcWidth="10" arcHeight="10">
                <fill>
                    <LinearGradient startX="0.0" startY="0.0" endX="0.0" endY="1.0">
                        <stops>
                            <Stop color="#FFD700"/>
                            <Stop color="#DAA520" offset="1.0"/>
                        </stops>
                    </LinearGradient>
                </fill>
                <effect>
                    <DropShadow color="#00000066" radius="8" spread="0.05"/>
                </effect>
            </Rectangle>
            <VBox alignment="CENTER" spacing="8">
                <Label text="1" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <effect>
                        <DropShadow/>
                    </effect>
                </Label>
                <StackPane>
                    <Circle radius="35" fx:id="firstPlaceCircle" fill="white" stroke="#DAA520" strokeWidth="3"/>
                    <Label fx:id="firstPlaceInitial" text="E1" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                </StackPane>
                <Label fx:id="firstPlaceId" text="ID: --" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="firstPlaceAchievement" text="--" style="-fx-background-color: rgba(46, 125, 50, 0.7); -fx-text-fill: white; -fx-padding: 3 10; -fx-background-radius: 10;"/>
                <Label fx:id="firstPlaceLeaves" text="Leaves: 0" style="-fx-text-fill: white;"/>
            </VBox>
        </StackPane>

        <!-- Third Place Podium -->
        <StackPane AnchorPane.leftAnchor="530" AnchorPane.bottomAnchor="0">
            <Rectangle width="150" height="100" arcWidth="10" arcHeight="10">
                <fill>
                    <LinearGradient startX="0.0" startY="0.0" endX="0.0" endY="1.0">
                        <stops>
                            <Stop color="#CD7F32"/>
                            <Stop color="#A05A2C" offset="1.0"/>
                        </stops>
                    </LinearGradient>
                </fill>
                <effect>
                    <DropShadow color="#00000066" radius="5" spread="0.05"/>
                </effect>
            </Rectangle>
            <VBox alignment="CENTER" spacing="5">
                <Label text="3" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <effect>
                        <DropShadow/>
                    </effect>
                </Label>
                <StackPane>
                    <Circle radius="28" fx:id="thirdPlaceCircle" fill="white" stroke="#A05A2C" strokeWidth="2"/>
                    <Label fx:id="thirdPlaceInitial" text="E3" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                </StackPane>
                <Label fx:id="thirdPlaceId" text="ID: --" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="thirdPlaceAchievement" text="--" style="-fx-background-color: rgba(25, 118, 210, 0.7); -fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 10;"/>
                <Label fx:id="thirdPlaceLeaves" text="Leaves: 0" style="-fx-text-fill: white;"/>
            </VBox>
        </StackPane>
    </AnchorPane>

    <!-- Table Section with Card Style -->
    <!-- Table Section with Card Style -->
    <StackPane fx:id="tableSectionStackPane">
        <Rectangle fx:id="tableBackgroundRectangle" arcWidth="15" arcHeight="15" fill="white">
            <effect>
                <DropShadow color="#00000033" radius="10" spread="0.05"/>
            </effect>
        </Rectangle>

        <TableView fx:id="tableView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background-radius: 15;">
            <columns>
                <TableColumn fx:id="colRanking" text="Rank" style="-fx-alignment: CENTER;" prefWidth="60"/>
                <TableColumn fx:id="colEmployeeId" text="Employee ID" style="-fx-alignment: CENTER;" prefWidth="100"/>
                <TableColumn fx:id="colJobId" text="Position ID" style="-fx-alignment: CENTER;" prefWidth="100"/>
                <TableColumn fx:id="colConfirmedLeave" text="Confirmed Leaves" style="-fx-alignment: CENTER;" prefWidth="140"/>
                <TableColumn fx:id="colNotConfirmedLeave" text="Pending Leaves" style="-fx-alignment: CENTER;" prefWidth="140"/>
                <TableColumn fx:id="colAchievement" text="Achievement" style="-fx-alignment: CENTER;" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </StackPane>

    <!-- Action Buttons -->
    <HBox alignment="CENTER" spacing="20">
        <Button text="Refresh Leaderboard" onAction="#refreshLeaderboard"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16">
                    <Image url="@../icons/refresh.png"/>
                </ImageView>
            </graphic>
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>
            <effect>
                <DropShadow color="#00000040" radius="5" spread="0.05"/>
            </effect>
        </Button>

        <Button text="Export Data"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16">
                    <Image url="@../icons/export.png"/>
                </ImageView>
            </graphic>
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>
            <effect>
                <DropShadow color="#00000040" radius="5" spread="0.05"/>
            </effect>
        </Button>
    </HBox>
</VBox>