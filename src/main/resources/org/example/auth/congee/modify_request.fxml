<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.Congee.ModifyRequestController"
      style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Title -->
    <Label text="Modify Leave Request" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f8fafc; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.4), 15, 0, 0, 2);" alignment="CENTER"/>

    <!-- Form Grid -->
    <GridPane hgap="15" vgap="15" style="-fx-background-color: rgba(30, 41, 59, 0.7); -fx-padding: 20; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-border-color: rgba(59, 130, 246, 0.2);">
        <!-- Start Date (Read-Only) -->
        <Label text="Start Date:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="startDatePicker" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px;" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false" mouseTransparent="true" focusTraversable="false"/>

        <!-- End Date (Read-Only) -->
        <Label text="End Date:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="endDatePicker" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px;" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="false" mouseTransparent="true" focusTraversable="false"/>

        <!-- Description -->
        <Label text="Description:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionArea" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Leave Type (Read-Only) -->
        <Label text="Leave Type:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="leaveTypeComboBox" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: rgba(59, 130, 246, 0.2); -fx-padding: 8px;" GridPane.rowIndex="3" GridPane.columnIndex="1" editable="false" mouseTransparent="true" focusTraversable="false"/>

        <!-- PDF File -->
        <Label text="PDF File:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Button text="Upload PDF" onAction="#handleUploadPdf" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 20px; -fx-padding: 8px 16px; -fx-cursor: hand;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label fx:id="pdfPathLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #94a3b8;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Save Changes Button -->
    <Button text="Save Changes" onAction="#handleSaveChanges"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;"/>
</VBox>