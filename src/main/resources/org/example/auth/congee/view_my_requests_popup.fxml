<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.auth.controllers.Congee.ViewMyRequestsPopupController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Section des compteurs -->
    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="counter-section">
        <Label text="Confirmed Days:"/>
        <Label fx:id="confirmedDaysLabel" text="0" styleClass="counter-value"/>
        <Label text="Remaining Days:"/>
        <Label fx:id="remainingDaysLabel" text="18" styleClass="counter-value"/>
    </HBox>

    <!-- Saisie de l'ID employé -->
    <VBox spacing="10" styleClass="input-section">
        <Label text="Enter Your Employee ID:"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="employeeIdField" promptText="Employee ID" styleClass="text-field"/>
            <Button text="View Requests" onAction="#handleViewRequests" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <!-- Tableau des demandes -->
    <TableView fx:id="leaveRequestsTable" styleClass="table-view">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50">
                <cellValueFactory>
                    <PropertyValueFactory property="id"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="startDateColumn" text="Start Date" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="startDate"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="endDateColumn" text="End Date" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="endDate"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="leaveTypeColumn" text="Type" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="leaveType"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200">
                <cellValueFactory>
                    <PropertyValueFactory property="description"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="isConfirmedColumn" text="Confirmed" prefWidth="100"/>
            <TableColumn fx:id="pdfPathColumn" text="PDF Path" prefWidth="200"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150"/>
            <TableColumn fx:id="applyJobColumn" text="Apply Job" prefWidth="100"/>
            <TableColumn fx:id="viewRemoteJobColumn" text="View Remote Job" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
