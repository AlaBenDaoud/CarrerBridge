<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auth.controllers.connexion.CompanyDashController"
            style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">

    <!-- Side Navbar -->
    <left>
        <VBox spacing="20" alignment="CENTER" style="-fx-background-color: #1e293b;" prefWidth="250">
            <padding>
                <Insets top="40" right="20" bottom="40" left="20"/>
            </padding>

            <!-- Post an Offer Button -->
            <Button text="Post an Offer" fx:id="postOfferButton" onAction="#handlePostOffer" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>

            <!-- View My Posts Button -->
            <Button text="View My Posts" fx:id="viewPostsButton" onAction="#handleViewPosts" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>

            <!-- View Applicants Button -->
            <Button text="View Applicants" fx:id="viewApplicantsButton" onAction="#handleViewApplicants" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>

            <!-- View Employees Button -->
            <Button text="View Employees" fx:id="viewEmployeesButton" onAction="#handleViewEmployees" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>

            <!-- View All Leave Requests Button -->
            <Button text="View All Leave Requests" fx:id="viewLeaveRequestsButton" onAction="#handleViewLeaveRequests" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>

            <!-- View Reclamations Button -->
            <Button text="View Reclamations" fx:id="viewReclamationsButton" onAction="#handleViewReclamations" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>

            <!-- View Online Jobs Button -->
            <Button text="View Online Jobs" fx:id="viewOnlineJobsButton" onAction="#handleViewOnlineJobs" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>

            <!-- View Employee Rankings Button -->
            <Button text="View Employee Rankings" fx:id="viewEmployeeRankingsButton" onAction="#handleViewEmployeeRankings" prefWidth="200" prefHeight="50"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-cursor: hand;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <fx:include source="../JobAndApplication/post_view.fxml"/>
    </center>
</BorderPane>