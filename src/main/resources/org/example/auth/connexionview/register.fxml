<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.auth.controllers.connexion.UserController" spacing="10">
    <Label text="Name:"/>
    <TextField fx:id="nameField" promptText="Enter your name"/>

    <Label text="Email:"/>
    <TextField fx:id="emailField" promptText="Enter your email"/>

    <Label text="Password:"/>
    <PasswordField fx:id="passwordField" promptText="Enter your password"/>

    <Label text="CV:"/>
    <TextField fx:id="cvField" promptText="No file selected" editable="false"/>

    <Button fx:id="chooseCvButton" text="Choose CV File" />
    <Button fx:id="registerButton" text="Register" />
</VBox>
