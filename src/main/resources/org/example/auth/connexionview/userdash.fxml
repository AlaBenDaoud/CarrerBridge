<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.web.WebView?>
<?import javafx.fxml.FXMLLoader?>
<?import javafx.scene.Parent?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.auth.controllers.connexion.UserDashController"
            style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(30, 41, 59, 0.95); -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.4), 15, 0, 0, 3);">
            <Button text="Search for Job" fx:id="searchJobButton" onAction="#handleSearchJob"
                    style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;">
            </Button>
            <Button text="View My Applications" fx:id="viewApplicationsButton" onAction="#handleViewApplications"
                    style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;">
            </Button>
            <Button text="Edit My Profile" fx:id="editProfileButton" onAction="#handleEditProfile"
                    style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;">
            </Button>
            <Button text="Consult My Work" fx:id="consultWorkButton" onAction="#handleConsultWork"
                    style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;" visible="false">
            </Button>
            <Button text="Create Post" fx:id="createPostButton" onAction="#handleCreatePost"
                    style="-fx-text-fill: white; -fx-background-color: #27ae60; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 25px; -fx-cursor: hand;">
            </Button>
        </HBox>
    </top>

    <!-- Main Content Area (Loads Other Pages) -->
    <center>
        <fx:include source="../JobAndApplication/post_view.fxml"/>
    </center>

</BorderPane>