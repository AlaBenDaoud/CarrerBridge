<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.auth.controllers.MainController"
      styleClass="root"
      stylesheets="@styles.css">

    <!-- Fixed Navigation Bar -->
    <HBox styleClass="navbar" alignment="CENTER">
        <MenuBar styleClass="menu-bar">
            <menus>
                <Menu text="Admin" styleClass="menu-item">
                    <items>
                        <MenuItem text="Login" onAction="#handleAdminLogin"/>
                    </items>
                </Menu>
                <Menu text="Company" styleClass="menu-item">
                    <items>
                        <MenuItem text="Login" onAction="#handleCompanyLogin"/>
                        <MenuItem text="Register" onAction="#handleCompanyRegister"/>
                    </items>
                </Menu>
                <Menu text="User" styleClass="menu-item">
                    <items>
                        <MenuItem text="Login" onAction="#handleUserLogin"/>
                        <MenuItem text="Register" onAction="#handleUserRegister"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </HBox>

    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" styleClass="content-scroll-pane">
        <VBox>
            <!-- Hero Section -->
            <StackPane styleClass="hero-section">
                <VBox styleClass="hero-content">
                    <Label text="Welcome to" styleClass="welcome-text-small"/>
                    <Label text="Business Management System" styleClass="welcome-text-large"/>
                    <Label text="Streamline your business operations with our comprehensive solution"
                           styleClass="welcome-description"/>
                    <Button text="Explore Now" styleClass="hero-button"/>
                </VBox>
            </StackPane>

            <!-- Feature Cards Section -->
            <GridPane styleClass="features-grid">
                <VBox styleClass="feature-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Admin" styleClass="card-title"/>
                    <Label text="Manage system settings and user permissions with advanced controls"
                           styleClass="card-description"/>
                    <Button text="Learn More" styleClass="card-button"/>
                </VBox>

                <VBox styleClass="feature-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Company" styleClass="card-title"/>
                    <Label text="Optimize resources and streamline business operations efficiently"
                           styleClass="card-description"/>
                    <Button text="Learn More" styleClass="card-button"/>
                </VBox>

                <VBox styleClass="feature-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="User" styleClass="card-title"/>
                    <Label text="Access powerful tools and manage accounts seamlessly"
                           styleClass="card-description"/>
                    <Button text="Learn More" styleClass="card-button"/>
                </VBox>
            </GridPane>

            <!-- Call to Action Section -->
            <StackPane styleClass="cta-section">
                <VBox alignment="CENTER" spacing="20">
                    <Label text="Ready to Transform Your Business?" styleClass="cta-title"/>
                    <Label text="Join thousands of satisfied customers today" styleClass="cta-subtitle"/>
                    <Button text="Get Started" styleClass="cta-button"/>
                </VBox>
            </StackPane>
        </VBox>
    </ScrollPane>
</VBox>