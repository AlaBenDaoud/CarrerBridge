<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.jobboardapp.Controller.MainController"
      spacing="30" alignment="CENTER" style="-fx-background-color: #ffffff;"
      stylesheets="@style.css">
    <padding>
        <Insets top="60" right="60" bottom="60" left="60"/>
    </padding>

    <!-- Title -->
    <Text text="Job Board Application" style="-fx-fill: #2c3e50;">
        <font>
            <Font name="Roboto" size="36" />
        </font>
        <effect>
            <DropShadow color="#aaaaaa" radius="5" spread="0.2" offsetX="2" offsetY="2"/>
        </effect>
    </Text>

    <!-- Buttons Container -->
    <VBox spacing="20" alignment="CENTER">
        <!-- Post a Job Button -->
        <Button text="Post a Job" fx:id="postJobButton" onAction="#handlePostJobButton" prefWidth="300" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="#16a085" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>

        <!-- View Jobs Button -->
        <Button text="View Jobs" fx:id="viewJobsButton" onAction="#handleViewJobsButton" prefWidth="300" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="#2980b9" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>

        <!-- View Details Button -->
        <Button text="View Details" fx:id="viewDetailsButton" onAction="#handleViewDetailsButton" prefWidth="300" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="#d35400" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>

        <!-- View Applications by Company ID Button -->
        <Button text="View Applications by Company ID" fx:id="viewApplicationsButton" onAction="#handleViewApplicationsButton" prefWidth="300" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="#8e44ad" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>

        <!-- View by Applicant ID Button -->
        <Button text="View by Applicant ID" fx:id="viewApplicantByIdButton" onAction="#handleViewApplicantByIdButton" prefWidth="300" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="#27ae60" radius="5" spread="0.1" offsetX="2" offsetY="2"/>
            </effect>
        </Button>
    </VBox>
</VBox>