<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.demo.jobboardapp.Controller.ViewJobsController"
            prefHeight="400.0" prefWidth="600.0">

    <!-- VBox for better layout -->
    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
        <!-- Back Button -->
        <Button text="Back to Main" fx:id="backButton" onAction="#handleBackButton"
                prefWidth="250" style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;" />

        <!-- Table View -->
        <TableView fx:id="jobsTable" prefWidth="560" prefHeight="300">
            <columns>
                <TableColumn text="ID" fx:id="idColumn" prefWidth="50" minWidth="50" maxWidth="100"/>
                <TableColumn text="Title" fx:id="titleColumn" prefWidth="150" minWidth="100" maxWidth="200"/>
                <TableColumn text="Company" fx:id="companyColumn" prefWidth="150" minWidth="100" maxWidth="200"/>
                <TableColumn text="Location" fx:id="locationColumn" prefWidth="100" minWidth="80" maxWidth="150"/>
                <TableColumn text="Posted Date" fx:id="postedDateColumn" prefWidth="150" minWidth="120" maxWidth="200"/>
                <TableColumn text="Actions" fx:id="actionColumn" prefWidth="100" minWidth="80" maxWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>