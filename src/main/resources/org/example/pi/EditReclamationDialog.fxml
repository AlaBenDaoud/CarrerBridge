<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<DialogPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pi.controllers.EditReclamationDialogController">
    <content>
        <VBox spacing="10">
            <GridPane hgap="10" vgap="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- User ID -->
                <Label text="User ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="userIdField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <!-- Receiver -->
                <Label text="Receiver:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="receiverField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <!-- Title -->
                <Label text="Title:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="titleField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <!-- Description -->
                <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextArea fx:id="descriptionField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <!-- Image Path -->
                <Label text="Image Path:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="imagePathField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                <!-- PDF Path -->
                <Label text="PDF Path:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <TextField fx:id="pdfPathField" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                <!-- Date -->
                <!-- Date (non-editable) -->
                <Label text="Date:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <Label fx:id="dateLabel" GridPane.rowIndex="6" GridPane.columnIndex="1" />
            </GridPane>

            <!-- Button to save changes -->
            <Button text="Save" onAction="#handleSave" />
        </VBox>
    </content>
</DialogPane>