<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pi.controllers.EditReclamationStateDialogController" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Edit Reclamation Status" style="-fx-font-size: 18; -fx-font-weight: bold;" />
    <Label text="Select Status:" />
    <ComboBox fx:id="statusComboBox" promptText="Choose Status" />
    <Button text="Save" onAction="#handleSave" />
</VBox>