<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pi.controllers.ModifierReponseReclamationController">

    <Label text="Modify Reclamation Response" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="Response ID:"/>
    <TextField fx:id="txtId" editable="false"/>

    <Label text="New Response:"/>
    <TextArea fx:id="txtReponse" prefRowCount="3" wrapText="true"/>

    <HBox spacing="10">
        <Button text="Save" onAction="#enregistrerModification"/>
        <Button text="Cancel" onAction="#fermerFenetre"/>
    </HBox>
</VBox>