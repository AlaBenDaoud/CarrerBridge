<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pi.controllers.ReclamationSubmissionController" spacing="15" alignment="CENTER">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Titre de l'interface -->
    <Label text="Reclamation Submission Form" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333333;" />

    <Label text="Submit Reclamation" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333333;" />

    <GridPane hgap="15" vgap="15" alignment="CENTER">
        <!-- User ID -->
        <Label text="User ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="userIdField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Enter your User ID" style="-fx-padding: 5; -fx-border-color: #ccc; -fx-border-radius: 5;"/>

        <!-- Receiver (RH or Admin) -->
        <Label text="Receiver:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <ComboBox fx:id="receiverComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Select Receiver" />

        <!-- Title -->
        <Label text="Title:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="titleField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Enter Title" style="-fx-padding: 5; -fx-border-color: #ccc; -fx-border-radius: 5;"/>

        <!-- Description -->
        <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextArea fx:id="descriptionField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Enter Description" style="-fx-padding: 5; -fx-border-color: #ccc; -fx-border-radius: 5;"/>

        <!-- Image Upload -->
        <Label text="Image:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <TextField fx:id="imagePathField" editable="false" style="-fx-padding: 5; -fx-border-color: #ccc; -fx-border-radius: 5;" />
            <Button text="Choose Image" onAction="#handleChooseImage" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 5; -fx-background-radius: 5;"/>
        </HBox>

        <!-- PDF Upload -->
        <Label text="PDF:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
        <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <TextField fx:id="pdfPathField" editable="false" style="-fx-padding: 5; -fx-border-color: #ccc; -fx-border-radius: 5;" />
            <Button text="Choose PDF" onAction="#handleChoosePdf" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 5; -fx-background-radius: 5;"/>
        </HBox>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Submit Reclamation" onAction="#handleSubmitReclamation" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 5;"/>
        <Button text="View All Reclamations" onAction="#handleViewAllReclamations" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 5;"/>
    </HBox>
</VBox>