<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pi.controllers.ViewAllReclamationsController" spacing="10" style="-fx-background-color: #f9f9f9;">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-pref-height: 50;">
        <Label text="Search:" style="-fx-font-size: 14;"/>
        <TextField fx:id="searchField" promptText="Enter keyword..." onKeyReleased="#handleSearch"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER" style="-fx-pref-height: 50;">
        <Label text="All Reclamations" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
    </HBox>

    <HBox spacing="10" alignment="TOP_RIGHT" style="-fx-pref-height: 50;">
        <Button text="Refresh" onAction="#handleRefresh" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 5;"/>
    </HBox>

    <TableView fx:id="reclamationTable" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 5;">
        <columns>
            <TableColumn text="ID" fx:id="idColumn" />
            <TableColumn text="User ID" fx:id="userIdColumn" />
            <TableColumn text="Receiver" fx:id="receiverColumn" />
            <TableColumn text="Title" fx:id="titleColumn" />
            <TableColumn text="Description" fx:id="descriptionColumn" />
            <TableColumn text="Image Path" fx:id="imagePathColumn" />
            <TableColumn text="PDF Path" fx:id="pdfPathColumn" />
            <TableColumn text="Date" fx:id="dateColumn" />
            <TableColumn fx:id="statueColumn" text="Status" />
            <TableColumn text="Actions" fx:id="actionsColumn" />
        </columns>
    </TableView>

    <!-- Pagination -->
    <Pagination fx:id="pagination" />
</VBox>