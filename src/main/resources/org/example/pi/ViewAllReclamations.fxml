<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pi.controllers.ViewAllReclamationsController" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="All Reclamations" style="-fx-font-size: 18; -fx-font-weight: bold;" />
    <TableView fx:id="reclamationTable">
        <columns>
            <TableColumn text="ID" fx:id="idColumn" />
            <TableColumn text="User ID" fx:id="userIdColumn" />
            <TableColumn text="Receiver" fx:id="receiverColumn" />
            <TableColumn text="Title" fx:id="titleColumn" />
            <TableColumn text="Description" fx:id="descriptionColumn" />
            <TableColumn text="Image Path" fx:id="imagePathColumn" />
            <TableColumn text="PDF Path" fx:id="pdfPathColumn" />
            <TableColumn text="Date" fx:id="dateColumn" />
            <TableColumn fx:id="statueColumn" text="Status" />
            <TableColumn text="Actions" fx:id="actionsColumn" />
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button text="Refresh" onAction="#handleRefresh" />
        <Button text="Delete" onAction="#handleDelete" />
        <Button text="Modify" onAction="#handleModify" />
        <Button text="Answer" onAction="#handleAnswer" />
    </HBox>
</VBox>